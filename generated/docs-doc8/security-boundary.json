{
  "schemaVersion": 1,
  "phase": "DOC-8",
  "endpoint": "/api/gallery/run",
  "publicArbitraryExecution": false,
  "publicUserSourceExecution": true,
  "productionMode": "same-origin-isolated",
  "developmentMode": "trusted-local-opt-in",
  "developmentOptIn": "ENABLE_LOCAL_APEXIFY_CODE_RUN=true",
  "sandboxClaim": false,
  "environmentPolicy": "allowlist",
  "cwdPolicy": "per-run-temporary-directory",
  "cleanup": "recursive-finally",
  "networkIsolation": true,
  "subprocessIsolation": true,
  "systemAccess": [
    "cpus"
  ],
  "workspaceFiles": true,
  "multiOutput": true,
  "mediaSubprocessPolicy": "fixed-ffmpeg-proxy-only",
  "externalExecutorApi": false,
  "externalExecutorToken": false,
  "packageInstallation": false,
  "remoteScriptExecution": false,
  "resourceLimits": {
    "executionMs": 55000,
    "sourceChars": 280000,
    "outputBytes": 33554432,
    "totalOutputBytes": 67108864,
    "processBufferBytes": 20971520,
    "shareStateBytes": 65536,
    "maxOutputs": 24
  }
}
